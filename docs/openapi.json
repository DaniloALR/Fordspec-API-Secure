            "title": "Attributes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "brand",
          "model",
          "version"
        ],
        "title": "SecureSpecRequestIn"
      },
      "SpecItem": {
        "properties": {
          "attribute": {
            "type": "string",
            "title": "Attribute"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "value": {
            "type": "string",
            "title": "Value"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "status": {
            "type": "string",
