# Copie para .env e preencha. NUNCA versione o .env (está no .gitignore).
# Gere valores fortes com:  python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=production

# --- Segredos da aplicação (mínimo 32 caracteres) ---
JWT_SECRET=
# várias chaves separadas por vírgula = rotação (a 1ª cifra, todas decifram)
DATA_ENC_KEYS=
HMAC_SECRET=
PSEUDO_SALT=
BACKUP_ENC_KEY=
# mesmo valor do arquivo secrets/metrics_token.txt (lido pelo Prometheus)
METRICS_TOKEN=

# --- Rede ---
ALLOWED_HOSTS=localhost,127.0.0.1,api
ALLOWED_ORIGINS=http://localhost:8081

# --- Banco (docker compose) ---
POSTGRES_USER=fordspec
POSTGRES_PASSWORD=
POSTGRES_DB=fordspec
DATABASE_URL=postgresql+psycopg2://fordspec:<POSTGRES_PASSWORD>@db:5432/fordspec

# --- Usuários iniciais (opcional; se vazio, o seed gera senhas aleatórias) ---
SEED_PASSWORD_BRIGADISTA=
SEED_PASSWORD_GESTOR=
SEED_PASSWORD_ADMINISTRADOR=

# --- IoT ---
IOT_HMAC_MASTER_KEY=

# --- Grafana ---
GF_SECURITY_ADMIN_PASSWORD=
